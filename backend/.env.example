DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bibig
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
NODE_ENV=development
# Google OAuth client IDs accepted by the API. Use the Web ID alone, or both the
# Web and Android IDs separated by a comma. GOOGLE_CLIENT_ID is still supported.
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_ID=
# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
